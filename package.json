{
  "name": "calendario-neurocoop",
  "version": "1.0.0",
  "description": "Sistema de Calendario Corporativo NEUROCOOP",
  "author": "NEUROCOOP",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "electron:dev": "electron .",
    "icon": "node build/make-icon.js",
    "vendor:node": "node build/fetch-node-runtime.js",
    "obfuscate": "node build/obfuscate.js",
    "stage": "node build/stage.js",
    "verify:staged": "node build/verify-staged.js",
    "build:desktop": "npm run icon && npm run vendor:node && npm run obfuscate && npm run stage && npm run verify:staged && electron-builder --win"
  },
  "dependencies": {
