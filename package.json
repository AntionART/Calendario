    "express": "^4.22.2",
    "express-session": "^1.19.0",
    "helmet": "^7.2.0",
    "localtunnel": "^2.0.2",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "javascript-obfuscator": "^4.1.1",
    "png-to-ico": "^2.1.8",
    "pngjs": "^7.0.0"
  }
